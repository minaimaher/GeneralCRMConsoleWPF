<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!--
      CRM environments shown on the sign-in screen. Name after "Environment:"; value is the
      Organization.svc address. Add "|production" to mark production: the app then shows a red
      banner and asks for typed confirmation before every change.
      Credentials are never stored here: users sign in with their Windows account or type a password.
    -->
    <add key="Environment:Development" value="https://your-dev-crm/ORG/XRMServices/2011/Organization.svc" />
    <add key="Environment:Pre-production" value="https://your-preprod-crm/ORG/XRMServices/2011/Organization.svc" />
    <add key="Environment:Production" value="https://your-prod-crm/ORG/XRMServices/2011/Organization.svc|production" />

    <!-- Interface language at start-up: en or ar -->
    <add key="Language" value="en" />

    <!-- Where run evidence is written. Empty = Documents\CRM Function Runner\Runs. A shared folder works too. -->
    <add key="EvidenceFolder" value="" />

    <!-- Functions marked "needs fix" in the SOP stay locked unless this is true (use only in test environments). -->
    <add key="AllowNeedsFixFunctions" value="false" />

    <!-- Read each record's current values before an update so the evidence shows before → after. -->
    <add key="CaptureBeforeValues" value="true" />

    <!-- Settings read by the console functions themselves (same meaning as in MyConsole App.config). -->
    <add key="Take" value="40000" />
    <add key="Skip" value="0" />
    <add key="License_Logs_Location" value="D:/Scheduler_License_LicenseRenewal_Logs/" />
    <add key="License_Renewal_Workflow" value="F33AD879-3E39-4EC5-8355-380110F25A86" />
    <add key="License_Notification30Days_Workflow" value="B8A89BC8-D78A-4F21-BAE1-91C0FE01BEFB" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>
