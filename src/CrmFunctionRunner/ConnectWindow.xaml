<Window x:Class="CrmFunctionRunner.ConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="clr-namespace:CrmFunctionRunner.Infrastructure"
        Title="{Binding [Connect.Title], Source={x:Static i:Loc.Instance}}"
        FlowDirection="{Binding Direction, Source={x:Static i:Loc.Instance}}"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" Background="{StaticResource Bg}" Foreground="{StaticResource Ink}">
    <Border Style="{StaticResource Card}" Margin="16">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="0" Padding="8,3" Click="Language_Click"
                        Content="{Binding [Language], Source={x:Static i:Loc.Instance}}" />
                <TextBlock Text="{Binding [AppTitle], Source={x:Static i:Loc.Instance}}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
            </DockPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,4" Text="{Binding [Connect.Intro], Source={x:Static i:Loc.Instance}}" />

            <TextBlock Style="{StaticResource Label}" Text="{Binding [Environment], Source={x:Static i:Loc.Instance}}" />
            <ComboBox x:Name="EnvironmentBox" Padding="6,5" />

            <RadioButton x:Name="WindowsAuth" Margin="0,14,0,4" IsChecked="True" GroupName="auth"
                         Content="{Binding [Connect.Windows], Source={x:Static i:Loc.Instance}}" Checked="Auth_Changed" />
            <RadioButton x:Name="PasswordAuth" Margin="0,4,0,0" GroupName="auth"
                         Content="{Binding [Connect.Password], Source={x:Static i:Loc.Instance}}" Checked="Auth_Changed" />

            <StackPanel x:Name="PasswordPanel" Visibility="Collapsed" Margin="22,4,0,0">
                <TextBlock Style="{StaticResource Label}" Text="{Binding [Connect.User], Source={x:Static i:Loc.Instance}}" />
                <TextBox x:Name="UserBox" FlowDirection="LeftToRight" />
                <TextBlock Style="{StaticResource Label}" Text="{Binding [Connect.Pwd], Source={x:Static i:Loc.Instance}}" />
                <PasswordBox x:Name="PasswordBox" FlowDirection="LeftToRight" />
            </StackPanel>

            <Border x:Name="ErrorBox" Visibility="Collapsed" Margin="0,14,0,0" Padding="10,8" CornerRadius="4" Background="{StaticResource CritSoft}">
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{StaticResource Crit}" />
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button x:Name="ConnectButton" Style="{StaticResource PrimaryBtn}" IsDefault="True" Click="Connect_Click"
                        Content="{Binding [Connect.Go], Source={x:Static i:Loc.Instance}}" />
                <Button Style="{StaticResource Btn}" IsCancel="True" Content="{Binding [Cancel], Source={x:Static i:Loc.Instance}}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
